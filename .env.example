# Set 1 to use the public, unauthenticated search endpoints on an existing machine.
MUPHO_ENABLE_SEARCH=
# Absolute SQLite path on local persistent storage, with a writable parent directory.
MUPHO_SEARCH_DB=
# Public project/contact URL for the provider User-Agent.
MUPHO_PROVIDER_CONTACT=
# Optional comma-separated Wikimedia Commons page IDs to suppress.
MUPHO_BLOCKED_COMMONS_IDS=
# Optional HTTPS URL for image reports.
MUPHO_REPORT_URL=
# Random session signing secret of at least 32 characters.
MUPHO_SESSION_SECRET=
# Optional IP header overwritten by your trusted reverse proxy. Leave empty for direct connections.
MUPHO_TRUSTED_IP_HEADER=
# Enable only with a dedicated Free Groq organization, no payment method, and Zero Data Retention enabled.
MUPHO_GROQ_FREE_ZDR=
# Server-only key from that organization. Never use a Developer/Paid key.
GROQ_API_KEY=
# Exact browser origin (HTTPS for public hosts, literal HTTP loopback for local validation).
MUPHO_GROQ_ORIGIN=
